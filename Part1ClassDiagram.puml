@startuml Part1ClassDiagram
class Employee{
    -firstName : String
    -lastName : String
    -socialSecurityNumber : String
    +setFirstName(firstName : String) : void
    +getFirstName() : String
    +setLastName(lastName : String) : void
    +getLastName() : String
    +setSocialSecurityNumber(ssn : String) : void
    +getSocialSecurityNumber() : String
    +toString() : String
}
class SalariedEmployee extends Employee{
    -weeklySalary : double
    +setWeeklySalary(weeklySalary : double) : void
    +getWeeklySalary() : double
    +toString() : String
}
class HourlyEmployee extends Employee{
    -wage : double
    -hoursWorked : double
    +setWage(wage : double) : void
    +getWage() : double
    +setHoursWorked(hoursWorked : double) : void
    +getHoursWorked() : double
    +toString() : String
}
class CommisionEmployee extends Employee{
    -commissionRate : double
    -grossSales : double
    +setCommissionRate(rate : double) : void
    +getCommissionRate() : double
    +setGrossSales(grossSales : double) : void
    +getGrossSales() : double
    +toString() : String
}
class BaseEmployee extends Employee{
    -baseSalary : double
    +setBaseSalary(baseSalary : double) : void
    +getBaseSalary() : double
    +toString() : String
}
@enduml